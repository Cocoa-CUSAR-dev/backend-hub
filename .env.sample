# Copy to .env (gitignored) and fill in real values, or set these as
# GitHub Actions secrets / your host's environment variables directly.
#
# Every setting below is read in src/config.py, in the same order. (required)
# means the app won't start without it; everything else has a default, which
# is the value shown here unless the comment says otherwise.

# --- App ----------------------------------------------------------------------
# local, dev, staging or production. Also Sentry's environment tag.
ENVIRONMENT=local
# Shown in /health and the API docs.
# APP_VERSION=0.1.0
# Origins allowed to call this API from a browser (JSON list), e.g. the LIFF page.
CORS_ORIGINS=["http://localhost:5173"]
# Swagger UI at /docs + ReDoc at /redoc. Leave commented = on everywhere
# except production; uncomment to force it on or off.
# API_DOCS_ENABLED=true
# Don't set VERCEL yourself: Vercel sets it on every deployment, and its
# presence turns the in-process scheduler off (see src/main.py).

# --- Database -----------------------------------------------------------------
# (required) SQLAlchemy async needs the asyncpg driver in the URL, not the plain
# postgresql:// scheme. This service never migrates the schema itself; that's
# the `database` repo's job (Flyway).
DATABASE_URL=postgresql+asyncpg://neondb_owner:<password>@<host>/neondb?ssl=require

# --- Auth (src/auth) ----------------------------------------------------------
# (required) Signs every access token. Same value as web-backend's and
# mobile-backend's JWT_KEY while they still run, so they accept tokens issued
# here. Long random string (32+ bytes).
JWT_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600
# Sliding: each refresh restarts the window.
REFRESH_TOKEN_TTL_DAYS=90
# The one-time link in the LINE diary card.
SSO_TOKEN_TTL_SECONDS=900
# Code researchers enter to sign themselves up. Empty = researcher sign-up off.
RESEARCHER_SIGNUP_CODE=

# --- The old Go backend (mobile-backend) --------------------------------------
# (required, both) The chatbot still asks Go for two things: a farmer's last
# answer (GET /service/tasks/last-answer) and the sanitized autofill
# (POST /service/autofill/sanitize), in src/tasks/client.py. These two go once
# those calls use backend-hub's own tasks.service instead.
GO_BACKEND_URL=http://localhost:8080
# Must match mobile-backend's CHATBOT_SERVICE_KEY exactly -- generate a strong
# random value for anything beyond local dev.
GO_SERVICE_KEY=

# --- Inbound service key ------------------------------------------------------
# (required) Callers of POST /service/notifications must send this as the
# X-Service-Key header. Only web-backend (Kotlin) calls it today; once Kotlin
# is off, nothing does. Distinct from GO_SERVICE_KEY, which this service sends.
CHATBOT_SERVICE_KEY=

# --- Cron trigger (src/jobs) --------------------------------------------------
# (required) Gates /internal/cron/* (reminders, pause-idle-conversations,
# recurrence): callers must send `Authorization: Bearer <CRON_SECRET>`. On a
# serverless deploy (Vercel) the in-process scheduler is off, so something
# external calls these: the cron-*.yml GitHub Actions workflows (repo secrets
# CRON_SECRET and CHATBOT_URL) or Vercel Cron Jobs. On a persistent host
# (Render, a VM, local `uvicorn`), src/jobs/scheduler.py runs the same jobs
# itself, but the setting is still required to start.
CRON_SECRET=

# --- LINE (line-bot-sdk-python) -----------------------------------------------
# (required, both) The Messaging API channel the chatbot runs on.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# The LIFF to-do list page (liff/). Empty = the LIFF routes refuse every token.
LIFF_ID=
# Extra LINE Login channels whose LIFF tokens may sign in (JSON list), besides
# the channel LIFF_ID belongs to -- e.g. the mobile app's own LIFF link page.
LINE_LOGIN_CHANNEL_IDS=[]
# US2-6: base URL of the web app, for the diary card's "view full history"
# button. A one-time SSO token is appended as #token= so the link opens the
# web app already signed in (src/sso/client.py).
WEB_APP_URL=
# US2-13: which farms/plots a farmer is offered on farm and plot questions.
# farmer = only farms linked to the person (agriculture.farmer_farm) and
#          their plots -- use this in production.
# all    = every farm and plot -- for dev/test accounts not linked to a farm,
#          which would otherwise see an empty list.
PLOT_SCOPE_MODE=farmer

# --- LLM (LiteLLM -- ADR 0004) ------------------------------------------------
# A LiteLLM-format string, e.g. "gpt-4o-mini" (the default),
# "claude-3-5-haiku-20241022", "gemini/gemini-1.5-flash" -- switching providers
# is a config change here, not code.
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=
# Seconds to wait for the LLM before treating it as unavailable.
LLM_TIMEOUT_SECONDS=6
# The daily diary's LLM polish (pushed to LINE after the reply, so it may be slower).
DIARY_LLM_TIMEOUT_SECONDS=20
# US2-11 free-text intent routing. false = only the exact start keywords work,
# exactly like before this feature (kill switch; no deploy needed to flip).
INTENT_ROUTING_ENABLED=true
# Below this self-reported confidence, a classified message is treated as
# "not understood" and gets the plain hint instead.
INTENT_MIN_CONFIDENCE=0.6

# --- Farm photos: Cloudflare R2 (S3-compatible) -------------------------------
# Leave any of these blank to turn farm photo upload off (it answers 503);
# nothing else depends on them. Bucket: cocoa-farm-images-dev / -prod.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Error tracking (X-2d) ----------------------------------------------------
# Leave SENTRY_DSN blank to disable the SDK entirely (safe for local dev/CI) --
# get the real DSN from the team's Sentry project. Sentry's environment tag
# comes from ENVIRONMENT above, not a separate setting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
